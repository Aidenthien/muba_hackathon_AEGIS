# Enoki zkLogin — https://enoki.mystenlabs.com
# Both values are meant to be public/client-side (Enoki's "publishable" API key +
# your OAuth client ID), so NEXT_PUBLIC_ is intentional here.
#
# 1. Create an app in the Enoki portal, add the "google" auth provider, and copy its
#    public API key below.
# 2. Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console and add
#    this app's URL (e.g. http://localhost:3000/demo) as an Authorized redirect URI.
#    Paste the client ID in both the Enoki portal and below.
#
# If these are left unset, the demo falls back to wallet-extension-only connect
# (no "Sign in with Google" option).
NEXT_PUBLIC_ENOKI_API_KEY=
NEXT_PUBLIC_ENOKI_GOOGLE_CLIENT_ID=
