{
  "manifest_version": 3,
  "name": "AEGIS — Pre-Execution Security Oracle",
  "version": "0.1.0",
  "description": "Simulates and risk-scores every Sui transaction before you sign it. Zero custody, no admin keys.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "AEGIS",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*", "https://*/*"],
      "js": ["inpage.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],
  "permissions": ["storage"],
  "host_permissions": [
    "https://aegis-ai-agent-production.up.railway.app/*",
    "http://localhost:3001/*",
    "http://127.0.0.1:3001/*"
  ]
}
